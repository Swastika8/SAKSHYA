LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional provider model override. No key means deterministic mock mode.
LLM_MODEL=
# auto: try cached multilingual model, otherwise TF-IDF (no startup download).
# transformer: allow first-run download; tfidf: deterministic offline retrieval.
RAG_MODE=auto
# Production should set this to the deployed frontend URL (comma-separated for several, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000
